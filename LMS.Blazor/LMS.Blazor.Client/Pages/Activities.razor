@page "/modules/{ModuleId:guid}/activities"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Net
@using System.Net.Http.Headers
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.ActivityDtos
@using LMS.Shared.DTOs.DocumentDtos
@using LMS.Shared.DTOs.ModuleDtos
@using Microsoft.AspNetCore.Authorization

@* Teacher page: list, create, edit, delete and view the activities of one module.
   The activity endpoints are teacher-only, so the whole page is teacher-only.
   An activity has its own start date + time and end date + time, so it can span several days.
   Documents (US06): the detail card and the edit form show the activity's documents (ActivityDocuments).
   When creating an activity the teacher can also pick one optional document, uploaded right after the save.
   Built with the shared components in Components/ (PageHeader, SuccessAlert, LoadingSkeleton, ErrorState, EmptyState,
   StatusBadge, ConfirmDeleteAlert). Shared styling comes from wwwroot/css/lms.css. *@
@attribute [Authorize(Roles = UserRoles.Teacher)]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Activities</PageTitle>

<div class="d-flex flex-column gap-4">

    @* ---------- Page header ---------- *@
    <PageHeader Title="@(module?.Name ?? "Activities")" Subtitle="@Subtitle">
        <Breadcrumb>
            @* Back link to the module list of the course *@
            <a href="courses">Courses</a>
            @if (module is not null)
            {
                <span> / </span><a href="courses/@module.CourseId/modules">Modules</a><span> / @module.Name</span>
            }
        </Breadcrumb>
        <Actions>
            @if (!showForm && module is not null)
            {
                <button type="button" class="btn btn-primary" @onclick="StartCreate">+ Add activity</button>
            }
        </Actions>
    </PageHeader>

    <SuccessAlert Message="@successMessage" OnDismiss="DismissSuccess" />

    @* ---------- Loading, error, empty and list states ---------- *@
    @if (isLoading)
    {
        <LoadingSkeleton />
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <ErrorState Message="@loadError" OnRetry="LoadAllAsync" />
    }
    else if (activities is not null)
    {
        <div class="row g-3">
            @* ---------- Activity table (left) ---------- *@
            <div class="col-12 @(showForm || selected is not null ? "col-xl-8" : "col-xl-12")">
                @if (activities.Count == 0)
                {
                    <EmptyState Title="No activities yet" Description="Add the first activity with the button above." />
                }
                else
                {
                    <div class="lms-card mb-3">
                        @* ---------- Filter by type + sort (US15). The list is small and already loaded,
                           so this is done in the browser; no request is sent. ---------- *@
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <select class="form-select form-select-sm w-auto" aria-label="Filter by type"
                                    value="@(typeFilter?.ToString() ?? string.Empty)" @onchange="OnTypeFilterChanged"
                                    style="min-width: 140px;">
                                <option value="">All types</option>
                                @foreach (var type in activityTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>

                            <select class="form-select form-select-sm w-auto" aria-label="Sort by"
                                    value="@sortBy" @onchange="OnSortChanged"
                                    style="min-width: 140px;">
                                <option value="@SortByStart">Sort: start time</option>
                                <option value="@SortByName">Sort: name</option>
                                <option value="@SortByType">Sort: type</option>
                            </select>

                            <span class="lms-cell-sub ms-auto">@VisibleActivities.Count of @activities.Count shown</span>
                        </div>
                    </div>

                    <div class="lms-card lms-card-table">
                        @if (VisibleActivities.Count == 0)
                        {
                            <EmptyState Icon="i" Tone="muted" InCard="false" Title="No activities of this type"
                                        Description="Pick another type or show all types." />
                        }

                        <div class="table-responsive">
                            <table class="table lms-table align-middle">
                                <thead>
                                    <tr>
                                        @* Start and end each show date and time, so multi-day activities are clear *@
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Activity</th>
                                        <th>Type</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in VisibleActivities)
                                    {
                                        @* The activity open in the detail card is highlighted *@
                                        <tr class="@(item.Id == selected?.Id ? "lms-row-highlight" : string.Empty)">
                                            <td class="text-nowrap">@FormatDateTime(item.StartTime)</td>
                                            <td class="text-nowrap">@FormatDateTime(item.EndTime)</td>
                                            <td>
                                                <button type="button" class="btn btn-link p-0 text-decoration-none lms-cell-title text-start"
                                                        @onclick="() => Select(item)">
                                                    @item.Name
                                                </button>
                                            </td>
                                            <td><StatusBadge Text="@item.ActivityTypeName" Tone="@ToneOf(item.ActivityTypeName)" /></td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-link btn-sm text-decoration-none" @onclick="() => StartEdit(item)">Edit</button>
                                                <button type="button" class="btn btn-link btn-sm text-decoration-none text-danger" @onclick="() => AskDelete(item)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            @* ---------- Create / edit form (right) ---------- *@
            @if (showForm)
            {
                <div class="col-12 col-xl-4">
                    <div class="lms-card">
                        <h2 class="lms-card-title mb-3">@(editingId is null ? "Add activity" : "Edit activity")</h2>

                        @if (!string.IsNullOrWhiteSpace(formError))
                        {
                            <div class="alert alert-danger" role="alert">@formError</div>
                        }

                        <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
                            <DataAnnotationsValidator />

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="activity-type">Type *</label>
                                    <InputSelect id="activity-type" class="form-select" @bind-Value="form.ActivityTypeId">
                                        <option value="@Guid.Empty">Select a type</option>
                                        @foreach (var type in activityTypes)
                                        {
                                            <option value="@type.Id">@type.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => form.ActivityTypeId" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="activity-name">Name *</label>
                                    <InputText id="activity-name" class="form-control" @bind-Value="form.Name" />
                                    <ValidationMessage For="() => form.Name" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="activity-description">Description</label>
                                    <InputTextArea id="activity-description" class="form-control" rows="3" @bind-Value="form.Description" />
                                    <ValidationMessage For="() => form.Description" />
                                </div>

                                @* Start: date and time *@
                                <div class="col-6">
                                    <label class="form-label" for="activity-start-date">Start date *</label>
                                    <InputDate id="activity-start-date" class="form-control" @bind-Value="form.StartDate" />
                                    <ValidationMessage For="() => form.StartDate" />
                                </div>

                                <div class="col-6">
                                    <label class="form-label" for="activity-start-time">Start time *</label>
                                    <InputDate id="activity-start-time" Type="InputDateType.Time" class="form-control" @bind-Value="form.StartTime" />
                                    <ValidationMessage For="() => form.StartTime" />
                                </div>

                                @* End: date and time (may be a later day than the start) *@
                                <div class="col-6">
                                    <label class="form-label" for="activity-end-date">End date *</label>
                                    <InputDate id="activity-end-date" class="form-control" @bind-Value="form.EndDate" />
                                    <ValidationMessage For="() => form.EndDate" />
                                </div>

                                <div class="col-6">
                                    <label class="form-label" for="activity-end-time">End time *</label>
                                    <InputDate id="activity-end-time" Type="InputDateType.Time" class="form-control" @bind-Value="form.EndTime" />
                                    <ValidationMessage For="() => form.EndTime" />
                                </div>

                                @* Optional document, only when creating. It is uploaded right after the activity is saved.
                                   When editing, the documents are managed below the form instead. *@
                                @if (editingId is null)
                                {
                                    <div class="col-12">
                                        <label class="form-label" for="activity-new-document">Document (optional)</label>
                                        @* The key changes when the form is reset, which clears the chosen file *@
                                        <InputFile @key="newFileKey" id="activity-new-document" class="form-control form-control-sm"
                                                   accept="@AcceptedExtensions" OnChange="OnNewFileSelected" />
                                        <div class="lms-cell-sub mt-1">PDF, Word, PowerPoint, Excel, text or images. Max @MaxFileSizeMb MB.</div>
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-outline-secondary" disabled="@isSaving" @onclick="CloseForm">Cancel</button>
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @(isSaving ? "Saving..." : (editingId is null ? "Add activity" : "Save activity"))
                                </button>
                            </div>
                        </EditForm>

                        @* ---------- Documents of the activity being edited (US06) ---------- *@
                        @if (editingId is not null)
                        {
                            <ActivityDocuments @key="editingId.Value" ActivityId="editingId.Value" CanManage="true" />
                        }
                    </div>
                </div>
            }
            else if (selected is not null)
            {
                @* Detail card (right), shown instead of the form *@
                <div class="col-12 col-xl-4">
                    <div class="lms-card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="lms-card-title mb-1">@selected.Name</h2>
                                <div class="lms-cell-sub">@FormatRange(selected.StartTime, selected.EndTime)</div>
                            </div>
                            <StatusBadge Text="@selected.ActivityTypeName" Tone="@ToneOf(selected.ActivityTypeName)" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(selected.Description))
                        {
                            <p>@selected.Description</p>
                        }
                        else
                        {
                            <p class="lms-cell-sub">No description has been added yet.</p>
                        }

                        @* ---------- Documents (US06): upload, download and delete for this activity ---------- *@
                        @* The key makes a fresh component per activity, so messages and a chosen file do not carry over *@
                        <ActivityDocuments @key="selected.Id" ActivityId="selected.Id" CanManage="true" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetail">Close</button>
                            <button type="button" class="btn btn-primary" @onclick="() => StartEdit(selected)">Edit</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ---------- Delete confirmation ---------- *@
    <ConfirmDeleteAlert Entity="activity"
                        ItemName="@deleting?.Name"
                        IsDeleting="isDeleting"
                        ErrorMessage="@deleteError"
                        OnConfirm="ConfirmDeleteAsync"
                        OnCancel="CancelDelete" />
</div>

@code {
    private readonly CancellationTokenSource cts = new();

    [Parameter]
    public Guid ModuleId { get; set; }

    private Guid loadedModuleId;
    private ModuleDto? module;
    private List<ActivityDto>? activities;
    private List<ActivityTypeDto> activityTypes = new();
    private ActivityDto? selected;

    // Filter + sort state (US15). Applied to the loaded list in VisibleActivities.
    private const string SortByStart = "start";
    private const string SortByName = "name";
    private const string SortByType = "type";
    private Guid? typeFilter;
    private string sortBy = SortByStart;

    // The rows shown in the table: the loaded activities, filtered by type and sorted by the chosen column.
    // Start time is always the tie-breaker, so two activities with the same name keep a predictable order.
    private List<ActivityDto> VisibleActivities
    {
        get
        {
            var visible = (activities ?? new())
                .Where(a => typeFilter is null || a.ActivityTypeId == typeFilter);

            visible = sortBy switch
            {
                SortByName => visible.OrderBy(a => a.Name).ThenBy(a => a.StartTime),
                SortByType => visible.OrderBy(a => a.ActivityTypeName).ThenBy(a => a.StartTime),
                _ => visible.OrderBy(a => a.StartTime)
            };

            return visible.ToList();
        }
    }

    private void OnTypeFilterChanged(ChangeEventArgs e) =>
        typeFilter = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private void OnSortChanged(ChangeEventArgs e) =>
        sortBy = e.Value?.ToString() ?? SortByStart;
    private bool isLoading = true;
    private string? loadError;

    private bool showForm;
    private Guid? editingId;
    private ActivityFormModel form = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messageStore = default!;
    private bool isSaving;
    private string? formError;
    private string? successMessage;

    // Optional document picked in the create form (US06). Must match the limits in DocumentService.
    private const int MaxFileSizeMb = 10;
    private const long MaxFileBytes = MaxFileSizeMb * 1024L * 1024L;
    private const string AcceptedExtensions = ".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.png,.jpg,.jpeg,.gif";
    private IBrowserFile? newFile;
    private Guid newFileKey = Guid.NewGuid();

    private ActivityDto? deleting;
    private bool isDeleting;
    private string? deleteError;

    // "4 May 2026 – 12 Jun 2026 · 5 activities"
    private string Subtitle
    {
        get
        {
            var parts = new List<string>();
            if (module is not null)
                parts.Add($"{FormatDate(module.StartDate)} – {FormatDate(module.EndDate)}");
            if (activities is not null)
                parts.Add($"{activities.Count} {(activities.Count == 1 ? "activity" : "activities")}");

            return parts.Count > 0
                ? string.Join(" · ", parts)
                : "Plan the activities of this module. They must stay inside the module dates and cannot overlap.";
        }
    }

    // Reload when the module id in the URL changes.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedModuleId == ModuleId) return;

        loadedModuleId = ModuleId;
        selected = null;
        CloseForm();
        await LoadAllAsync();
    }

    // Loads the module (for the header and dates), the activity types and the activities.
    private async Task LoadAllAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var loadedModule = await ApiProxyClient.GetAsync<ModuleDto>($"modules/{ModuleId}", cts.Token);

            // The server-side prerender client deliberately returns null. Keep
            // showing the loading state until WebAssembly runs this again.
            if (loadedModule is null)
            {
                return;
            }

            module = loadedModule;

            activityTypes = await ApiProxyClient.GetAsync<List<ActivityTypeDto>>("activity-types", cts.Token) ?? new();

            await ReloadActivitiesAsync();
            isLoading = false;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (HttpRequestException ex)
        {
            loadError = ex.StatusCode switch
            {
                HttpStatusCode.NotFound => "This module was not found.",
                HttpStatusCode.Forbidden => "You do not have access to the activities.",
                _ => "Could not load the activities. Please try again."
            };
            isLoading = false;
        }
    }

    // Fetches the activities only (used after create, edit and delete).
    private async Task ReloadActivitiesAsync()
    {
        var result = await ApiProxyClient.GetAsync<List<ActivityDto>>(
            $"modules/{ModuleId}/activities", cts.Token) ?? new();

        // Show them in time order, regardless of the order the API returns.
        activities = result.OrderBy(a => a.StartTime).ToList();

        // Keep the open detail card in sync, or close it if the activity is gone.
        if (selected is not null)
            selected = activities.FirstOrDefault(a => a.Id == selected.Id);
    }

    private void Select(ActivityDto item)
    {
        CloseForm();
        selected = item;
    }

    private void CloseDetail() => selected = null;

    private void StartCreate()
    {
        editingId = null;
        selected = null;

        // Suggest the module's first day, from 09:00 to 10:00 (the teacher can pick a later end date)
        form = new ActivityFormModel
        {
            StartDate = module!.StartDate,
            StartTime = new TimeOnly(9, 0),
            EndDate = module.StartDate,
            EndTime = new TimeOnly(10, 0)
        };

        CreateEditContext();
        ResetFormErrors();
        successMessage = null;
        showForm = true;
    }

    private void StartEdit(ActivityDto item)
    {
        editingId = item.Id;
        selected = null;

        // Split the stored start and end into separate date and time fields
        form = new ActivityFormModel
        {
            ActivityTypeId = item.ActivityTypeId,
            Name = item.Name,
            Description = item.Description,
            StartDate = DateOnly.FromDateTime(item.StartTime),
            StartTime = TimeOnly.FromDateTime(item.StartTime),
            EndDate = DateOnly.FromDateTime(item.EndTime),
            EndTime = TimeOnly.FromDateTime(item.EndTime)
        };

        CreateEditContext();
        ResetFormErrors();
        successMessage = null;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = null;
        newFile = null;
        newFileKey = Guid.NewGuid();
        form = new ActivityFormModel();
        ResetFormErrors();
    }

    private void CreateEditContext()
    {
        editContext = new EditContext(form);
        messageStore = new ValidationMessageStore(editContext);

        // Clear a field's server error as soon as the user edits that field.
        editContext.OnFieldChanged += (_, e) => messageStore.Clear(e.FieldIdentifier);
    }

    private void ResetFormErrors()
    {
        formError = null;
        messageStore?.Clear();
    }

    private void DismissSuccess() => successMessage = null;

    // Remembers the document chosen in the create form
    private void OnNewFileSelected(InputFileChangeEventArgs e) => newFile = e.File;

    private async Task SaveAsync()
    {
        ResetFormErrors();

        if (form.ActivityTypeId == Guid.Empty)
        {
            messageStore.Add(editContext.Field(nameof(ActivityFormModel.ActivityTypeId)), "Select a type.");
        }

        // Combine each date with its time. The end may be on a later day than the start.
        var start = form.StartDate.ToDateTime(form.StartTime);
        var end = form.EndDate.ToDateTime(form.EndTime);

        if (end <= start)
        {
            messageStore.Add(editContext.Field(nameof(ActivityFormModel.EndDate)),
                "The end must be after the start.");
        }

        // The activity must stay inside the module's dates (the API checks this too)
        if (module is not null)
        {
            var range = $"{FormatDate(module.StartDate)} – {FormatDate(module.EndDate)}";

            if (form.StartDate < module.StartDate || form.StartDate > module.EndDate)
            {
                messageStore.Add(editContext.Field(nameof(ActivityFormModel.StartDate)),
                    $"The start date must be inside the module ({range}).");
            }

            if (form.EndDate < module.StartDate || form.EndDate > module.EndDate)
            {
                messageStore.Add(editContext.Field(nameof(ActivityFormModel.EndDate)),
                    $"The end date must be inside the module ({range}).");
            }
        }

        // Check the optional document before anything is saved (the API checks it again)
        if (editingId is null && newFile is not null)
        {
            if (newFile.Size == 0)
            {
                formError = "The document is empty. Choose another file or remove it.";
            }
            else if (newFile.Size > MaxFileBytes)
            {
                formError = $"The document is too large. The maximum size is {MaxFileSizeMb} MB.";
            }

            if (formError is not null) return;
        }

        // Stop here if any client-side check failed
        if (editContext.GetValidationMessages().Any())
        {
            editContext.NotifyValidationStateChanged();
            return;
        }

        isSaving = true;

        try
        {
            var name = form.Name.Trim();
            var description = string.IsNullOrWhiteSpace(form.Description) ? null : form.Description.Trim();

            if (editingId is null)
            {
                var dto = new CreateActivityDto
                {
                    ActivityTypeId = form.ActivityTypeId,
                    Name = name,
                    Description = description,
                    StartTime = start,
                    EndTime = end,
                    ModuleId = ModuleId
                };

                var created = await ApiProxyClient.SendAsync<ActivityDto>(
                    HttpMethod.Post, "activities", JsonContent.Create(dto), cts.Token);

                successMessage = $"Activity '{name}' was created.";

                // Upload the optional document to the new activity. The activity is already saved,
                // so a failed upload only changes the message; the teacher can retry in the detail card.
                if (newFile is not null)
                {
                    var uploadError = created is null
                        ? "The new activity could not be found."
                        : await UploadNewDocumentAsync(created.Id, newFile);

                    successMessage = uploadError is null
                        ? $"Activity '{name}' was created with the document '{newFile.Name}'."
                        : $"Activity '{name}' was created, but the document was not uploaded: {uploadError} Open the activity to try again.";
                }
            }
            else
            {
                var dto = new UpdateActivityDto
                {
                    ActivityTypeId = form.ActivityTypeId,
                    Name = name,
                    Description = description,
                    StartTime = start,
                    EndTime = end
                };

                await ApiProxyClient.SendAsync<ActivityDto>(
                    HttpMethod.Put, $"activities/{editingId}", JsonContent.Create(dto), cts.Token);

                successMessage = $"Activity '{name}' was updated.";
            }

            CloseForm();
            await ReloadActivitiesAsync();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (ApiValidationException ex)
        {
            // Show the API's validation errors next to the matching fields.
            foreach (var (field, messages) in ex.Errors)
                messageStore.Add(editContext.Field(field), messages);

            if (ex.Errors.Count == 0)
                formError = ex.Message;

            editContext.NotifyValidationStateChanged();
        }
        catch (HttpRequestException ex)
        {
            formError = ex.StatusCode switch
            {
                HttpStatusCode.BadRequest => "The activity must be inside the module dates and end after it starts.",
                HttpStatusCode.Conflict => "The activity overlaps another activity in this module.",
                HttpStatusCode.NotFound => "The module, the activity or the type no longer exists.",
                HttpStatusCode.Forbidden => "You do not have permission to manage activities.",
                _ => "Could not save the activity. Please try again."
            };
        }
        finally
        {
            isSaving = false;
        }
    }

    // Uploads one document to an activity. Returns null on success, otherwise a short error text.
    private async Task<string?> UploadNewDocumentAsync(Guid activityId, IBrowserFile file)
    {
        try
        {
            // The form fields match UploadDocumentRequest on the API (exactly one target: the activity)
            var content = new MultipartFormDataContent();

            var fileContent = new StreamContent(file.OpenReadStream(MaxFileBytes, cts.Token));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
            content.Add(fileContent, "File", file.Name);
            content.Add(new StringContent(activityId.ToString()), "ActivityId");

            await ApiProxyClient.SendAsync<DocumentDto>(HttpMethod.Post, "documents", content, cts.Token);
            return null;
        }
        catch (ApiValidationException ex)
        {
            // 400: the API says what was wrong (file type, size)
            return ex.Errors.Count > 0
                ? string.Join(" ", ex.Errors.SelectMany(e => e.Value))
                : ex.Message;
        }
        catch (HttpRequestException)
        {
            return "The upload failed.";
        }
        catch (IOException)
        {
            return "The file could not be read.";
        }
    }

    private void AskDelete(ActivityDto item)
    {
        deleting = item;
        deleteError = null;
    }

    private void CancelDelete() => deleting = null;

    private async Task ConfirmDeleteAsync()
    {
        if (deleting is null) return;

        isDeleting = true;
        deleteError = null;

        try
        {
            await ApiProxyClient.SendAsync<ActivityDto>(
                HttpMethod.Delete, $"activities/{deleting.Id}", null, cts.Token);

            successMessage = $"Activity '{deleting.Name}' was deleted.";
            deleting = null;
            await ReloadActivitiesAsync();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (HttpRequestException)
        {
            deleteError = "Could not delete the activity. Please try again.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void RedirectToLogin() =>
        NavigationManager.NavigateTo(
            $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
            forceLoad: true);

    // "Mon 12 Oct"
    private static string FormatDate(DateTime value) =>
        value.ToString("ddd d MMM", CultureInfo.InvariantCulture);

    // "12 Oct 2026"
    private static string FormatDate(DateOnly value) =>
        value.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    // "09:00"
    private static string FormatTime(DateTime value) =>
        value.ToString("HH:mm", CultureInfo.InvariantCulture);

    // "Mon 12 Oct, 09:00" (used in the table, where start and end have their own column)
    private static string FormatDateTime(DateTime value) =>
        $"{FormatDate(value)}, {FormatTime(value)}";

    // Same day: "Mon 12 Oct, 09:00 – 10:00". Several days: "Mon 12 Oct, 09:00 – Wed 14 Oct, 16:00".
    private static string FormatRange(DateTime start, DateTime end) =>
        start.Date == end.Date
            ? $"{FormatDate(start)}, {FormatTime(start)} – {FormatTime(end)}"
            : $"{FormatDateTime(start)} – {FormatDateTime(end)}";

    // Badge colour name per activity type (falls back to muted for unknown types)
    private static string ToneOf(string typeName) => typeName switch
    {
        "Lecture" => "primary",
        "E-Learning" => "info",
        "Exercise" => "success",
        "Assignment" => "warning",
        _ => "muted"
    };

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    // Client-side rules, matching the activity DTOs on the API.
    private sealed class ActivityFormModel
    {
        // Guid.Empty means "nothing selected yet" (checked in SaveAsync)
        public Guid ActivityTypeId { get; set; }

        [Required(ErrorMessage = "Name is required.")]
        [MaxLength(50, ErrorMessage = "Name can be at most 50 characters.")]
        public string Name { get; set; } = string.Empty;

        [MaxLength(400, ErrorMessage = "Description can be at most 400 characters.")]
        public string? Description { get; set; }

        // Start and end are split into date + time so the activity can span several days
        public DateOnly StartDate { get; set; }

        public TimeOnly StartTime { get; set; }

        public DateOnly EndDate { get; set; }

        public TimeOnly EndTime { get; set; }
    }
}