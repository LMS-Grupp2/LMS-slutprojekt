@page "/modules/{ModuleId:guid}/activities"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Net
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.ActivityDtos
@using LMS.Shared.DTOs.ModuleDtos
@using Microsoft.AspNetCore.Authorization

@* Teacher page: list, create, edit, delete and view the activities of one module.
   The activity endpoints are teacher-only, so the whole page is teacher-only.
   Shared styling comes from wwwroot/css/lms.css. *@
@attribute [Authorize(Roles = UserRoles.Teacher)]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Activities</PageTitle>

<div class="d-flex flex-column gap-4">

    @* ---------- Page header ---------- *@
    <div class="lms-page-header">
        <div>
            @* Back link to the module list of the course *@
            <div class="lms-breadcrumb">
                <a href="courses">Courses</a>
                @if (module is not null)
                {
                    <span> / </span><a href="courses/@module.CourseId/modules">Modules</a><span> / @module.Name</span>
                }
            </div>
            <h1 class="lms-page-title">@(module?.Name ?? "Activities")</h1>
            <p class="lms-page-subtitle">@Subtitle</p>
        </div>

        @if (!showForm && module is not null)
        {
            <button type="button" class="btn btn-primary" @onclick="StartCreate">+ Add activity</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible mb-0" role="status">
            @successMessage
            <button type="button" class="btn-close" aria-label="Close" @onclick="DismissSuccess"></button>
        </div>
    }

    @* ---------- Loading, error, empty and list states ---------- *@
    @if (isLoading)
    {
        <div class="lms-card">
            <div class="d-flex flex-column gap-3">
                <div class="lms-skeleton" style="width: 40%; height: 16px;"></div>
                <div class="lms-skeleton" style="width: 70%; height: 16px;"></div>
                <div class="lms-skeleton" style="width: 55%; height: 16px;"></div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="lms-card">
            <div class="lms-state">
                <span class="lms-badge lms-tone-danger">!</span>
                <div class="lms-cell-title">@loadError</div>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="LoadAllAsync">Try again</button>
            </div>
        </div>
    }
    else if (activities is not null)
    {
        <div class="row g-3">

            @* ---------- Activity table (left) ---------- *@
            <div class="col-12 @(showForm || selected is not null ? "col-xl-8" : "col-xl-12")">
                @if (activities.Count == 0)
                {
                    <div class="lms-card">
                        <div class="lms-state">
                            <span class="lms-badge lms-tone-primary">+</span>
                            <div class="lms-cell-title">No activities yet</div>
                            <div class="lms-cell-sub">Add the first activity with the button above.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="lms-card lms-card-table">
                        <div class="table-responsive">
                            <table class="table lms-table align-middle">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Activity</th>
                                        <th>Type</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in activities)
                                    {
                                        @* The activity open in the detail card is highlighted *@
                                        <tr class="@(item.Id == selected?.Id ? "lms-row-highlight" : string.Empty)">
                                            <td class="text-nowrap">@FormatDate(item.StartTime)</td>
                                            <td class="text-nowrap">@FormatTime(item.StartTime) – @FormatTime(item.EndTime)</td>
                                            <td>
                                                <button type="button" class="btn btn-link p-0 text-decoration-none lms-cell-title text-start"
                                                        @onclick="() => Select(item)">@item.Name</button>
                                            </td>
                                            <td><span class="lms-badge @ToneOf(item.ActivityTypeName)">@item.ActivityTypeName</span></td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-link btn-sm text-decoration-none" @onclick="() => StartEdit(item)">Edit</button>
                                                <button type="button" class="btn btn-link btn-sm text-decoration-none text-danger" @onclick="() => AskDelete(item)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            @* ---------- Create / edit form (right) ---------- *@
            @if (showForm)
            {
                <div class="col-12 col-xl-4">
                    <div class="lms-card">
                        <h2 class="lms-card-title mb-3">@(editingId is null ? "Add activity" : "Edit activity")</h2>

                        @if (!string.IsNullOrWhiteSpace(formError))
                        {
                            <div class="alert alert-danger" role="alert">@formError</div>
                        }

                        <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
                            <DataAnnotationsValidator />

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="activity-type">Type *</label>
                                    <InputSelect id="activity-type" class="form-select" @bind-Value="form.ActivityTypeId">
                                        <option value="@Guid.Empty">Select a type</option>
                                        @foreach (var type in activityTypes)
                                        {
                                            <option value="@type.Id">@type.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => form.ActivityTypeId" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="activity-name">Name *</label>
                                    <InputText id="activity-name" class="form-control" @bind-Value="form.Name" />
                                    <ValidationMessage For="() => form.Name" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="activity-description">Description</label>
                                    <InputTextArea id="activity-description" class="form-control" rows="3" @bind-Value="form.Description" />
                                    <ValidationMessage For="() => form.Description" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="activity-date">Date *</label>
                                    <InputDate id="activity-date" class="form-control" @bind-Value="form.Date" />
                                    <ValidationMessage For="() => form.Date" />
                                </div>

                                <div class="col-6">
                                    <label class="form-label" for="activity-start">Start time *</label>
                                    <InputDate id="activity-start" Type="InputDateType.Time" class="form-control" @bind-Value="form.StartTime" />
                                    <ValidationMessage For="() => form.StartTime" />
                                </div>

                                <div class="col-6">
                                    <label class="form-label" for="activity-end">End time *</label>
                                    <InputDate id="activity-end" Type="InputDateType.Time" class="form-control" @bind-Value="form.EndTime" />
                                    <ValidationMessage For="() => form.EndTime" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-outline-secondary" disabled="@isSaving" @onclick="CloseForm">Cancel</button>
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @(isSaving ? "Saving..." : (editingId is null ? "Add activity" : "Save activity"))
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else if (selected is not null)
            {
                @* Detail card (right), shown instead of the form *@
                <div class="col-12 col-xl-4">
                    <div class="lms-card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="lms-card-title mb-1">@selected.Name</h2>
                                <div class="lms-cell-sub">@FormatDate(selected.StartTime), @FormatTime(selected.StartTime) – @FormatTime(selected.EndTime)</div>
                            </div>
                            <span class="lms-badge @ToneOf(selected.ActivityTypeName)">@selected.ActivityTypeName</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(selected.Description))
                        {
                            <p>@selected.Description</p>
                        }
                        else
                        {
                            <p class="lms-cell-sub">No description has been added yet.</p>
                        }

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetail">Close</button>
                            <button type="button" class="btn btn-primary" @onclick="() => StartEdit(selected)">Edit</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ---------- Delete confirmation ---------- *@
    @if (deleting is not null)
    {
        <div class="alert alert-warning mb-0" role="alert">
            <div class="mb-2">Delete the activity <strong>@deleting.Name</strong>? This cannot be undone.</div>
            @if (!string.IsNullOrWhiteSpace(deleteError))
            {
                <div class="text-danger mb-2">@deleteError</div>
            }
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-danger btn-sm" disabled="@isDeleting" @onclick="ConfirmDeleteAsync">
                    @(isDeleting ? "Deleting..." : "Delete")
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@isDeleting" @onclick="CancelDelete">Cancel</button>
            </div>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource cts = new();

    [Parameter]
    public Guid ModuleId { get; set; }

    private Guid loadedModuleId;
    private ModuleDto? module;
    private List<ActivityDto>? activities;
    private List<ActivityTypeDto> activityTypes = new();
    private ActivityDto? selected;
    private bool isLoading = true;
    private string? loadError;

    private bool showForm;
    private Guid? editingId;
    private ActivityFormModel form = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messageStore = default!;
    private bool isSaving;
    private string? formError;
    private string? successMessage;

    private ActivityDto? deleting;
    private bool isDeleting;
    private string? deleteError;

    // "4 May 2026 – 12 Jun 2026 · 5 activities"
    private string Subtitle
    {
        get
        {
            var parts = new List<string>();
            if (module is not null)
                parts.Add($"{FormatDate(module.StartDate)} – {FormatDate(module.EndDate)}");
            if (activities is not null)
                parts.Add($"{activities.Count} {(activities.Count == 1 ? "activity" : "activities")}");

            return parts.Count > 0
                ? string.Join(" · ", parts)
                : "Plan the activities of this module. They must stay inside the module dates and cannot overlap.";
        }
    }

    // Reload when the module id in the URL changes.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedModuleId == ModuleId) return;

        loadedModuleId = ModuleId;
        selected = null;
        CloseForm();
        await LoadAllAsync();
    }

    // Loads the module (for the header and dates), the activity types and the activities.
    private async Task LoadAllAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var loadedModule = await ApiProxyClient.GetAsync<ModuleDto>($"modules/{ModuleId}", cts.Token);

            // The server-side prerender client deliberately returns null. Keep
            // showing the loading state until WebAssembly runs this again.
            if (loadedModule is null)
            {
                return;
            }

            module = loadedModule;

            activityTypes = await ApiProxyClient.GetAsync<List<ActivityTypeDto>>("activity-types", cts.Token) ?? new();

            await ReloadActivitiesAsync();
            isLoading = false;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (HttpRequestException ex)
        {
            loadError = ex.StatusCode switch
            {
                HttpStatusCode.NotFound => "This module was not found.",
                HttpStatusCode.Forbidden => "You do not have access to the activities.",
                _ => "Could not load the activities. Please try again."
            };
            isLoading = false;
        }
    }

    // Fetches the activities only (used after create, edit and delete).
    private async Task ReloadActivitiesAsync()
    {
        var result = await ApiProxyClient.GetAsync<List<ActivityDto>>(
            $"modules/{ModuleId}/activities", cts.Token) ?? new();

        // Show them in time order, regardless of the order the API returns.
        activities = result.OrderBy(a => a.StartTime).ToList();

        // Keep the open detail card in sync, or close it if the activity is gone.
        if (selected is not null)
            selected = activities.FirstOrDefault(a => a.Id == selected.Id);
    }

    private void Select(ActivityDto item)
    {
        CloseForm();
        selected = item;
    }

    private void CloseDetail() => selected = null;

    private void StartCreate()
    {
        editingId = null;
        selected = null;

        // Suggest the module's first day, from 09:00 to 10:00
        form = new ActivityFormModel
        {
            Date = module!.StartDate,
            StartTime = new TimeOnly(9, 0),
            EndTime = new TimeOnly(10, 0)
        };

        CreateEditContext();
        ResetFormErrors();
        successMessage = null;
        showForm = true;
    }

    private void StartEdit(ActivityDto item)
    {
        editingId = item.Id;
        selected = null;

        form = new ActivityFormModel
        {
            ActivityTypeId = item.ActivityTypeId,
            Name = item.Name,
            Description = item.Description,
            Date = DateOnly.FromDateTime(item.StartTime),
            StartTime = TimeOnly.FromDateTime(item.StartTime),
            EndTime = TimeOnly.FromDateTime(item.EndTime)
        };

        CreateEditContext();
        ResetFormErrors();
        successMessage = null;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = null;
        form = new ActivityFormModel();
        ResetFormErrors();
    }

    private void CreateEditContext()
    {
        editContext = new EditContext(form);
        messageStore = new ValidationMessageStore(editContext);

        // Clear a field's server error as soon as the user edits that field.
        editContext.OnFieldChanged += (_, e) => messageStore.Clear(e.FieldIdentifier);
    }

    private void ResetFormErrors()
    {
        formError = null;
        messageStore?.Clear();
    }

    private void DismissSuccess() => successMessage = null;

    private async Task SaveAsync()
    {
        ResetFormErrors();

        if (form.ActivityTypeId == Guid.Empty)
        {
            messageStore.Add(editContext.Field(nameof(ActivityFormModel.ActivityTypeId)), "Select a type.");
        }

        if (form.EndTime <= form.StartTime)
        {
            messageStore.Add(editContext.Field(nameof(ActivityFormModel.EndTime)),
                "The end time must be after the start time.");
            editContext.NotifyValidationStateChanged();
        }

        // Stop here if any client-side check failed
        if (editContext.GetValidationMessages().Any())
        {
            editContext.NotifyValidationStateChanged();
            return;
        }

        isSaving = true;

        try
        {
            var name = form.Name.Trim();
            var description = string.IsNullOrWhiteSpace(form.Description) ? null : form.Description.Trim();

            // Combine the chosen day with the start and end time
            var start = form.Date.ToDateTime(form.StartTime);
            var end = form.Date.ToDateTime(form.EndTime);

            if (editingId is null)
            {
                var dto = new CreateActivityDto
                {
                    ActivityTypeId = form.ActivityTypeId,
                    Name = name,
                    Description = description,
                    StartTime = start,
                    EndTime = end,
                    ModuleId = ModuleId
                };

                await ApiProxyClient.SendAsync<ActivityDto>(
                    HttpMethod.Post, "activities", JsonContent.Create(dto), cts.Token);

                successMessage = $"Activity '{name}' was created.";
            }
            else
            {
                var dto = new UpdateActivityDto
                {
                    ActivityTypeId = form.ActivityTypeId,
                    Name = name,
                    Description = description,
                    StartTime = start,
                    EndTime = end
                };

                await ApiProxyClient.SendAsync<ActivityDto>(
                    HttpMethod.Put, $"activities/{editingId}", JsonContent.Create(dto), cts.Token);

                successMessage = $"Activity '{name}' was updated.";
            }

            CloseForm();
            await ReloadActivitiesAsync();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (ApiValidationException ex)
        {
            // Show the API's validation errors next to the matching fields.
            foreach (var (field, messages) in ex.Errors)
                messageStore.Add(editContext.Field(field), messages);

            if (ex.Errors.Count == 0)
                formError = ex.Message;

            editContext.NotifyValidationStateChanged();
        }
        catch (HttpRequestException ex)
        {
            formError = ex.StatusCode switch
            {
                HttpStatusCode.BadRequest => "The activity must be inside the module dates and end after it starts.",
                HttpStatusCode.Conflict => "The activity overlaps another activity in this module.",
                HttpStatusCode.NotFound => "The module, the activity or the type no longer exists.",
                HttpStatusCode.Forbidden => "You do not have permission to manage activities.",
                _ => "Could not save the activity. Please try again."
            };
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskDelete(ActivityDto item)
    {
        deleting = item;
        deleteError = null;
    }

    private void CancelDelete() => deleting = null;

    private async Task ConfirmDeleteAsync()
    {
        if (deleting is null) return;

        isDeleting = true;
        deleteError = null;

        try
        {
            await ApiProxyClient.SendAsync<ActivityDto>(
                HttpMethod.Delete, $"activities/{deleting.Id}", null, cts.Token);

            successMessage = $"Activity '{deleting.Name}' was deleted.";
            deleting = null;
            await ReloadActivitiesAsync();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (HttpRequestException)
        {
            deleteError = "Could not delete the activity. Please try again.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void RedirectToLogin() =>
        NavigationManager.NavigateTo(
            $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
            forceLoad: true);

    private static string FormatDate(DateTime value) =>
        value.ToString("ddd d MMM", CultureInfo.InvariantCulture);

    private static string FormatDate(DateOnly value) =>
        value.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private static string FormatTime(DateTime value) =>
        value.ToString("HH:mm", CultureInfo.InvariantCulture);

    // Badge colour per activity type (falls back to muted for unknown types)
    private static string ToneOf(string typeName) => typeName switch
    {
        "Lecture" => "lms-tone-primary",
        "E-Learning" => "lms-tone-info",
        "Exercise" => "lms-tone-success",
        "Assignment" => "lms-tone-warning",
        _ => "lms-tone-muted"
    };

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    // Client-side rules, matching the activity DTOs on the API.
    private sealed class ActivityFormModel
    {
        // Guid.Empty means "nothing selected yet" (checked in SaveAsync)
        public Guid ActivityTypeId { get; set; }

        [Required(ErrorMessage = "Name is required.")]
        [MaxLength(50, ErrorMessage = "Name can be at most 50 characters.")]
        public string Name { get; set; } = string.Empty;

        [MaxLength(400, ErrorMessage = "Description can be at most 400 characters.")]
        public string? Description { get; set; }

        public DateOnly Date { get; set; }

        public TimeOnly StartTime { get; set; }

        public TimeOnly EndTime { get; set; }
    }
}