@page "/my-course"

@using System.Globalization
@using System.Net
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Student")]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>My course</PageTitle>

@if (isLoading)
{
    <p class="mc-muted"><em>Loading your course...</em></p>
}
else if (course is not null)
{
    var participants = course.Participants
        .Where(p => string.IsNullOrWhiteSpace(searchText) ||
                    p.Name.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();
    var progress = ProgressPercent(course.StartDate, course.EndDate);

    <header class="mc-header">
        <p class="mc-eyebrow">My course</p>
        <h1 class="mc-title">@course.Name</h1>
        <p class="mc-subtitle">@FormatDate(course.StartDate) – @FormatDate(course.EndDate)</p>
    </header>

    <section class="mc-card">
        <h2 class="mc-card-title">About the course</h2>

        @if (!string.IsNullOrWhiteSpace(course.Description))
        {
            <p class="mc-description">@course.Description</p>
        }
        else
        {
            <p class="mc-description mc-muted">No description has been added yet.</p>
        }

        <dl class="mc-facts">
            <div>
                <dt>Start date</dt>
                <dd>@FormatDate(course.StartDate)</dd>
            </div>
            <div>
                <dt>End date</dt>
                <dd>@FormatDate(course.EndDate)</dd>
            </div>
            <div>
                <dt>Classmates</dt>
                <dd>@course.Participants.Count</dd>
            </div>
        </dl>

        <div class="mc-progress" role="progressbar" aria-label="Course progress"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress">
            <div class="mc-progress-bar" style="width:@progress%"></div>
        </div>
    </section>

    <section class="mc-card">
        <div class="mc-card-head">
            <h2 class="mc-card-title">Classmates (@course.Participants.Count)</h2>
            <input type="search"
                   class="mc-search"
                   placeholder="Search classmates..."
                   aria-label="Search classmates"
                   @bind="searchText"
                   @bind:event="oninput" />
        </div>

        @if (participants.Count > 0)
        {
            <ul class="mc-grid">
                @foreach (var participant in participants)
                {
                    <li class="mc-person">
                        <span class="mc-avatar" style="background-color:@AvatarColor(participant.Name)">@Initials(participant.Name)</span>
                        <span class="mc-person-text">
                            <span class="mc-person-name">@participant.Name</span>
                            <span class="mc-person-role">Student</span>
                        </span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="mc-muted">No classmates match your search.</p>
        }

        <p class="mc-note">Only names are shown — email and other personal data are hidden from other students.</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(infoMessage))
{
    <div class="alert alert-info" role="status">@infoMessage</div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@code {
    private static readonly string[] AvatarColors =
    {
        "#0d6efd", "#7c3aed", "#198754", "#d97706", "#dc3545", "#0891b2"
    };

    private StudentCourseDto? course;
    private string? infoMessage;
    private string? errorMessage;
    private string searchText = string.Empty;
    private bool isLoading = true;
    private readonly CancellationTokenSource componentCancellation = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiProxyClient.GetAsync<StudentCourseDto>(
                "student/course",
                componentCancellation.Token);

            // The server-side prerender service deliberately returns null. Keep
            // showing the loading state until WebAssembly runs this method again.
            if (result is null)
                return;

            course = result;
        }
        catch (OperationCanceledException) when (componentCancellation.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels its request.
            return;
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
                forceLoad: true);
            return;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            infoMessage = "You are not enrolled in a course yet.";
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            errorMessage = "This page is only available to students.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "The course could not be loaded. Please try again later.";
        }

        isLoading = false;
    }

    private static string FormatDate(DateOnly date) =>
        date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    // Share of the course period that has passed, clamped to 0-100.
    private static int ProgressPercent(DateOnly start, DateOnly end)
    {
        var total = end.DayNumber - start.DayNumber;
        if (total <= 0)
            return 100;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var elapsed = today.DayNumber - start.DayNumber;

        return Math.Clamp((int)Math.Round(elapsed * 100.0 / total), 0, 100);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string AvatarColor(string? name)
    {
        var sum = 0;
        foreach (var c in name ?? string.Empty)
            sum += c;

        return AvatarColors[sum % AvatarColors.Length];
    }

    public void Dispose()
    {
        componentCancellation.Cancel();
        componentCancellation.Dispose();
    }
}