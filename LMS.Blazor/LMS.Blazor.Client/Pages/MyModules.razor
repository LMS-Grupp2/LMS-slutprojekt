@page "/my-modules"

@using System.Net
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.CourseDtos
@using Microsoft.AspNetCore.Authorization

@* Student entry point: redirects to the modules of the student's own course.
   Shows a loading skeleton while redirecting, or a message if there is no course.
   Styling comes from wwwroot/css/lms.css. *@
@attribute [Authorize(Roles = UserRoles.Student)]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>My modules</PageTitle>

<div class="lms-card" role="status">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="lms-state">
            <span class="lms-badge lms-tone-primary">i</span>
            <div class="lms-cell-title">@message</div>
            <div class="lms-cell-sub">Ask your teacher to add you to a course.</div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            <div class="lms-skeleton" style="width: 40%; height: 16px;"></div>
            <div class="lms-skeleton" style="width: 70%; height: 16px;"></div>
            <div class="lms-skeleton" style="width: 55%; height: 16px;"></div>
        </div>
        <span class="visually-hidden">Loading your modules...</span>
    }
</div>

@code {
    private readonly CancellationTokenSource cts = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var course = await ApiProxyClient.GetAsync<StudentCourseDto>("student/course", cts.Token);

            // The server-side prerender client deliberately returns null. Keep
            // showing the loading state until WebAssembly runs this again.
            if (course is null)
            {
                return;
            }

            // Go to the module page of the student's own course
            NavigationManager.NavigateTo($"courses/{course.Id}/modules", replace: true);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
                forceLoad: true);
        }
        catch (HttpRequestException ex)
        {
            message = ex.StatusCode == HttpStatusCode.NotFound
                ? "You are not enrolled in a course yet, so there are no modules to show."
                : "Could not load your course. Please try again later.";
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}