@page "/courses"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Net
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.Paging
@using Microsoft.AspNetCore.Authorization

@* Teacher overview of all courses, with an inline form to create and edit a course.
   Built with the shared components in Components/ (PageHeader, SuccessAlert, LoadingSkeleton, ErrorState,
   EmptyState, StatusBadge). Shared styling comes from wwwroot/css/lms.css.
   The course name opens the modules of the course. The page can also be opened with ?edit={courseId}
   (from the "Edit course" button on the modules page): then the edit form of that course opens at once,
   and Save / Cancel return to the modules page. *@
@attribute [Authorize(Roles = UserRoles.Teacher)]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Courses</PageTitle>

<div class="d-flex flex-column gap-4">

    @* ---------- Page header (different in form mode and list mode) ---------- *@
    @if (showForm)
    {
        <PageHeader Title="@(editingId is null ? "New course" : "Edit course")"
                    Subtitle="Fill in the course details. You can add modules afterwards.">
            <Breadcrumb>Courses / @(editingId is null ? "New course" : "Edit course")</Breadcrumb>
        </PageHeader>
    }
    else
    {
        <PageHeader Title="Courses" Subtitle="@CourseCountText">
            <Actions>
                <button type="button" class="btn btn-primary" @onclick="StartCreate">+ New course</button>
            </Actions>
        </PageHeader>
    }

    <SuccessAlert Message="@successMessage" OnDismiss="DismissSuccess" />

    @* ---------- Create / edit form with a rules card next to it ---------- *@
    @if (showForm)
    {
        <div class="row g-3">
            <div class="col-12 col-xl-8">
                <div class="lms-card">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong class="d-block">The course could not be saved</strong>
                            @formError
                        </div>
                    }

                    <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="course-name">Course name *</label>
                                <InputText id="course-name" class="form-control" @bind-Value="form.Name" />
                                <ValidationMessage For="() => form.Name" />
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="course-description">Description</label>
                                <InputTextArea id="course-description" class="form-control" rows="4" @bind-Value="form.Description" />
                                <ValidationMessage For="() => form.Description" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="course-start">Start date *</label>
                                <InputDate id="course-start" class="form-control" @bind-Value="form.StartDate" />
                                <ValidationMessage For="() => form.StartDate" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="course-end">End date *</label>
                                <InputDate id="course-end" class="form-control" @bind-Value="form.EndDate" />
                                <ValidationMessage For="() => form.EndDate" />
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" disabled="@isSaving" @onclick="CloseForm">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @(isSaving ? "Saving..." : "Save course")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="lms-card">
                    <h2 class="lms-card-title mb-3">Rules</h2>
                    <ul class="mb-0 ps-3 d-flex flex-column gap-2">
                        <li>Start date must be before end date.</li>
                        <li>Modules must fit inside the course dates.</li>
                        <li>Modules in the same course can't overlap.</li>
                        <li>All rules are also checked by the API.</li>
                    </ul>
                </div>
            </div>
        </div>
    }

    @* ---------- Loading, error, empty and list states ---------- *@
    @* ---------- Toolbar: search + status filter (US15), list mode only. Filtering happens in the API. ---------- *@
    @if (!showForm)
    {
        <div class="lms-card">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-8">
                    <SearchBox Value="@search" Placeholder="Search by course name" OnSearch="OnSearchAsync" />
                </div>
                <div class="col-12 col-md-4">
                    <select class="form-select" aria-label="Filter by status"
                            value="@(statusFilter ?? string.Empty)" @onchange="OnStatusChangedAsync">
                        <option value="">All statuses</option>
                        @foreach (var status in CourseStatus.All)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <LoadingSkeleton />
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <ErrorState Message="@loadError" OnRetry="LoadCoursesAsync" />
    }
    else if (courses is { Count: 0 } && HasFilters)
    {
        <EmptyState Icon="i" Tone="muted" Title="No courses match your filters"
                    Description="Try another search text or status.">
            <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="ClearFiltersAsync">Clear filters</button>
        </EmptyState>
    }
    else if (courses is { Count: 0 })
    {
        <EmptyState Title="No courses yet" Description="Create the first course with the button above." />
    }
    else if (courses is not null)
    {
        <div class="lms-card lms-card-table">
            <div class="table-responsive">
                <table class="table lms-table align-middle">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Start date</th>
                            <th>End date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in courses)
                        {
                            var status = StatusOf(course);

                            <tr>
                                <td>
                                    @* The course name opens the modules of the course (US04) *@
                                    <div class="lms-cell-title">
                                        <a class="text-decoration-none" href="courses/@course.Id/modules">@course.Name</a>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(course.Description))
                                    {
                                        <div class="lms-cell-sub">@course.Description</div>
                                    }
                                </td>
                                <td class="text-nowrap">@FormatDate(course.StartDate)</td>
                                <td class="text-nowrap">@FormatDate(course.EndDate)</td>
                                <td class="text-end text-nowrap">
                                    <StatusBadge Text="@status.Text" Tone="@status.Tone" />
                                    <button type="button" class="btn btn-link btn-sm text-decoration-none ms-2" @onclick="() => StartEdit(course)">Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource cts = new();

    // Optional ?edit={courseId} in the address: open the edit form of that course right away
    [SupplyParameterFromQuery(Name = "edit")]
    public Guid? EditCourseId { get; set; }

    // Set when the edit form was opened from the modules page: Save / Cancel then go back to that page
    private Guid? returnToModulesOf;

    private List<CourseDto>? courses;
    private bool isLoading = true;
    private string? loadError;

    private bool showForm;
    private Guid? editingId;
    private CourseFormModel form = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messageStore = default!;
    private bool isSaving;
    private string? formError;
    private string? successMessage;

    // The filters sent to the API as query-string parameters (US15)
    private string? search;
    private string? statusFilter;

    private bool HasFilters => search is not null || statusFilter is not null;

    // Builds "courses?search=net&status=Active". Without filters it is plain "courses", like before.
    private string CoursesEndpoint
    {
        get
        {
            var parameters = new List<string>();
            if (search is not null) parameters.Add($"search={Uri.EscapeDataString(search)}");
            if (statusFilter is not null) parameters.Add($"status={Uri.EscapeDataString(statusFilter)}");

            return parameters.Count == 0 ? "courses" : $"courses?{string.Join("&", parameters)}";
        }
    }

    // Subtitle under the page title, e.g. "5 courses" or "2 courses match your filters"
    private string CourseCountText
    {
        get
        {
            if (courses is null) return string.Empty;

            var count = courses.Count;

            return HasFilters
                ? $"{count} {(count == 1 ? "course matches" : "courses match")} your filters"
                : $"{count} {(count == 1 ? "course" : "courses")}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCoursesAsync();

        // Opened with ?edit={courseId}: show the edit form of that course. An unknown id is ignored.
        // (During the server prerender the courses are not loaded yet, then this runs again in WebAssembly.)
        if (EditCourseId is { } editId && courses?.FirstOrDefault(c => c.Id == editId) is { } courseToEdit)
        {
            returnToModulesOf = editId;
            StartEdit(courseToEdit);
        }
    }

    private Task OnSearchAsync(string? value)
    {
        search = value;
        return LoadCoursesAsync();
    }

    private Task OnStatusChangedAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        statusFilter = string.IsNullOrEmpty(value) ? null : value;
        return LoadCoursesAsync();
    }

    private Task ClearFiltersAsync()
    {
        search = null;
        statusFilter = null;
        return LoadCoursesAsync();
    }

    private async Task LoadCoursesAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var result = await ApiProxyClient.GetAsync<List<CourseDto>>(CoursesEndpoint, cts.Token);

            // The server-side prerender client deliberately returns null. Keep
            // showing the loading state until WebAssembly runs this again.
            if (result is null)
            {
                return;
            }

            // Newest course first, like the mockup (sorted by start date, descending)
            courses = result.OrderByDescending(c => c.StartDate).ToList();
            isLoading = false;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (HttpRequestException ex)
        {
            loadError = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have access to the courses."
                : "Could not load the courses. Please try again.";
            isLoading = false;
        }
    }

    private void StartCreate()
    {
        editingId = null;

        // Suggest today as the start date and a date one month ahead as the end date.
        var today = DateOnly.FromDateTime(DateTime.Today);
        form = new CourseFormModel { StartDate = today, EndDate = today.AddMonths(1) };

        CreateEditContext();
        ResetFormErrors();
        successMessage = null;
        showForm = true;
    }

    private void StartEdit(CourseDto course)
    {
        editingId = course.Id;
        form = new CourseFormModel
        {
            Name = course.Name,
            Description = course.Description,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };

        CreateEditContext();
        ResetFormErrors();
        successMessage = null;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = null;
        form = new CourseFormModel();
        ResetFormErrors();

        // The form was opened from the modules page: go back there
        if (returnToModulesOf is { } courseId)
        {
            returnToModulesOf = null;
            NavigationManager.NavigateTo($"courses/{courseId}/modules");
        }
    }

    private void CreateEditContext()
    {
        editContext = new EditContext(form);
        messageStore = new ValidationMessageStore(editContext);

        // Clear a field's server error as soon as the user edits that field.
        editContext.OnFieldChanged += (_, e) => messageStore.Clear(e.FieldIdentifier);
    }

    private void ResetFormErrors()
    {
        formError = null;
        messageStore?.Clear();
    }

    private void DismissSuccess() => successMessage = null;

    private async Task SaveAsync()
    {
        ResetFormErrors();

        // Same rule as the API: the start date cannot be after the end date.
        if (form.EndDate < form.StartDate)
        {
            messageStore.Add(editContext.Field(nameof(CourseFormModel.EndDate)),
                "The end date cannot be before the start date.");
            editContext.NotifyValidationStateChanged();
            return;
        }

        isSaving = true;

        try
        {
            var name = form.Name.Trim();
            var description = string.IsNullOrWhiteSpace(form.Description) ? null : form.Description.Trim();

            if (editingId is null)
            {
                var dto = new CreateCourseDto
                {
                    Name = name,
                    Description = description,
                    StartDate = form.StartDate,
                    EndDate = form.EndDate
                };

                await ApiProxyClient.SendAsync<CourseDto>(
                    HttpMethod.Post, "courses", JsonContent.Create(dto), cts.Token);

                successMessage = $"Course '{name}' was created.";
            }
            else
            {
                // The id is part of the route only, it is not sent in the body.
                var dto = new UpdateCourseDto
                {
                    Name = name,
                    Description = description,
                    StartDate = form.StartDate,
                    EndDate = form.EndDate
                };

                await ApiProxyClient.SendAsync<CourseDto>(
                    HttpMethod.Put, $"courses/{editingId}", JsonContent.Create(dto), cts.Token);

                successMessage = $"Course '{name}' was updated.";
            }

            CloseForm();
            await LoadCoursesAsync();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (ApiValidationException ex)
        {
            // Show the API's validation errors next to the matching fields.
            foreach (var (field, messages) in ex.Errors)
                messageStore.Add(editContext.Field(field), messages);

            if (ex.Errors.Count == 0)
                formError = ex.Message;

            editContext.NotifyValidationStateChanged();
        }
        catch (HttpRequestException ex)
        {
            formError = ex.StatusCode switch
            {
                HttpStatusCode.NotFound => "The course no longer exists.",
                HttpStatusCode.Forbidden => "You do not have permission to manage courses.",
                _ => "Could not save the course. Please try again."
            };
        }
        finally
        {
            isSaving = false;
        }
    }

    private void RedirectToLogin() =>
        NavigationManager.NavigateTo(
            $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
            forceLoad: true);

    private static string FormatDate(DateOnly date) =>
        date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    // Status is calculated from today's date: Upcoming / Active / Finished (as in the mockups).
    // Tone is the badge colour name used by StatusBadge.
    private static (string Text, string Tone) StatusOf(CourseDto course)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        // Same words and same date rule as the API's status filter (CourseRepository), via the shared constants.
        if (today > course.EndDate) return (CourseStatus.Finished, "muted");
        if (today >= course.StartDate) return (CourseStatus.Active, "success");
        return (CourseStatus.Upcoming, "info");
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    // Client-side rules, matching CreateCourseDto on the API.
    private sealed class CourseFormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Name must be between 2 and 100 characters.")]
        public string Name { get; set; } = string.Empty;

        [StringLength(1000, ErrorMessage = "Description can be at most 1000 characters.")]
        public string? Description { get; set; }

        public DateOnly StartDate { get; set; }

        public DateOnly EndDate { get; set; }
    }
}