@page "/submissions"

@using System.Globalization
@using System.Net
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.SubmissionDtos
@using Microsoft.AspNetCore.Authorization

@* Teacher overview of the hand-ins for one assignment (US10).
   The teacher picks a course and an assignment (AssignmentPicker), then sees one row per student with a status.
   The status cards show how many students have each status and filter the table when clicked.
   Built with the shared components in Components/. Styling comes from wwwroot/css/lms.css. *@
@attribute [Authorize(Roles = UserRoles.Teacher)]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Submissions</PageTitle>

<div class="d-flex flex-column gap-4">
    <PageHeader Title="Submissions" Subtitle="Check who has submitted, who is late or is missing" />

    @*----------Course + assignment----------*@
    <AssignmentPicker OnAssignmentSelected="OnAssignmentSelectedAsync" />

    @*----------Overview states----------*@
    @if (selectedAssignmentId is null)
    {
        <EmptyState Icon="i" Title="Choose a course and an assignment"
               Description="The files submitted of every student in the course will be here." />
    }
    else if (isLoadingOverview)
    {
        <LoadingSkeleton />
    }
    else if (!string.IsNullOrWhiteSpace(overviewError))
    {
        <ErrorState Message="@overviewError" OnRetry="() => LoadOverviewAsync(selectedAssignmentId)" />
    }
    else if (overview is {Rows.Count : 0 })
    {
        <EmptyState Icon="i" Title="No students are in this course"
            Description="Add students to this course to see their submissions" />
    }
    else if (overview is not null)
    {
        @*----------Status cards: a count per status and click to filter----------*@
        <div class="row g-3">
            @*All is always shown as default *@
            <div class="col-6 col-md">
                <button type="button" class="lms-card w-100 text-start border-0"
                    style="@CardStyle(null)" @onclick="() => selectedStatus = null">
                   <div class="fs-4 fw-bold">@overview.Rows.Count</div>
                   <div>All</div>
                </button>
            </div>
            
            @*The four status cards will always be shown with zeros included*@
            @foreach(var status in StatusOrder)
            {
                <div class="col-6 col-md">
                    <button type="button" class="lms-card w-100 text-start border-0"
                       style="@CardStyle(status)" @onclick="() => selectedStatus = status">
                      <div class="fs-4 fw-bold @(selectedStatus == status ? string.Empty : CountColour(status))">
                          @CountOf(status)
                      </div>
                      <div>@status</div>
                   </button> 
                </div>
            }
        </div>

        @*----------Table----------*@
        <div class="lms-card lms-card-table">
            @*Deadline will sitt above the table*@
            <div class="d-flex justify-content-end px-3 pt-3">
                <div class="text-end">
                    <div class="lms-cell-sub">Deadline</div>
                    <div class="lms-cell-title">@FormatDateTime(overview.Deadline)</div>
                    @*Late submissions are still accepted but will be shown as late*@
                    @if (overview.Deadline < DateTime.Now)
                    {
                        <StatusBadge Text="Deadline passed" Tone="muted" />
                    }
                    else
                    {
                        <StatusBadge Text="Open" Tone="success" />
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table lms-table align-middle">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Submitted</th>
                            <th>Files</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in VisibleRows)
                        {
                            @*Late or missing rows will get a highlight colour from lms*@
                            <tr class="@(NeedsAttention(row.Status) ? "lms-row-highlight" : string.Empty)">
                                <td class="lms-cell-title">@row.StudentName</td>

                               @*Submitted is utc time from the server so its shown as local time*@
                               <td class="text-nowrap @(row.Status == SubmissionStatus.Late ? "text-danger" : string.Empty)">
                                    @if (row.SubmittedAt is { } submittedAt)
                                    {
                                        @FormatDateTime(submittedAt.ToLocalTime())
                                        @if (row.Status == SubmissionStatus.Late)
                                        {
                                            <span> (late)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span> - </span>
                                    }
                                </td>

                                @*Each file downloads throuhg the BFF proxy done by us06 *@
                                <td>
                                    @if (row.Files.Count == 0)
                                    {
                                        <span> - </span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var file in row.Files)
                                            {
                                               <a class="text-decoration-none" href="api/proxy/documents/@file.Id/download">@file.Name</a> 
                                            }
                                        </div>
                                    }
                                </td>

                                <td><StatusBadge Text="@row.Status" Tone="@ToneOf(row.Status)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    // Those are the four status cards, always shown in this order
    private static readonly string[] StatusOrder =
    [
        SubmissionStatus.AwaitingFeedback,
        SubmissionStatus.Late,
        SubmissionStatus.Missing,
        SubmissionStatus.FeedbackGiven
    ];

    private readonly CancellationTokenSource cts = new();

    //The assignment picked in AssingmentPicker is null so none yet
    private Guid? selectedAssignmentId;

    //The overview from our API
    private SubmissionOverviewDto? overview;
    private bool isLoadingOverview;
    private string? overviewError;

    //The status card the teacher has clicked if none is clicked then we show all
    private string? selectedStatus;

    //Load the overview 
    private async Task LoadOverviewAsync(Guid? assignmentId)
    {
        overview = null;
        overviewError = null;

        //A new assignment will start unfiltered
        selectedStatus = null;

        //The choise was either cleared or the course changes so show the choose state
        if (assignmentId is null)
        {
            return;
        }

        isLoadingOverview = true;

        try
        {
            overview = await ApiProxyClient.GetAsync<SubmissionOverviewDto>(
                $"activities/{assignmentId}/submissions", cts.Token);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            //Navigating away will disppose the component and cancel the request.
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
                forceLoad: true);
        }
        catch (HttpRequestException ex)
        {
            overviewError = ex.StatusCode switch
            {
                HttpStatusCode.NotFound => "The assignment was not found.",
                HttpStatusCode.BadRequest => "This activity is not an assignment.",
                _ => "Could not load the submissions. Please try again"
            };
        }
        finally
        {
            isLoadingOverview = false;
        }
    }

    //Called by AssignmentPicker when an assignment is picked or cleared
    private async Task OnAssignmentSelectedAsync(Guid? assignmentId)
    {
        selectedAssignmentId = assignmentId;
        await LoadOverviewAsync(assignmentId);
    }

    // The rows shown in the table, filtered by the selected card and then sorted by name
    private IEnumerable<SubmissionOverviewRowDto> VisibleRows =>
        (overview?.Rows ?? [])
            .Where(r => selectedStatus is null || r.Status == selectedStatus)
            .OrderBy(r => r.StudentName);

    //A count to show how many students have this status
    private int CountOf(string status) =>
        overview?.Rows.Count(r => r.Status == status) ?? 0;

    // Badge coulour per status taken from lms.css
    private static string ToneOf(string status) => status switch
    {
        SubmissionStatus.Late => "danger",
        SubmissionStatus.Missing => "danger",
        SubmissionStatus.AwaitingFeedback => "warning",
        SubmissionStatus.FeedbackGiven => "info",
        _ => "muted"
    };

    //late and missing rows are highlighted so we can see them first
    private static bool NeedsAttention(string status) =>
        status == SubmissionStatus.Late || status == SubmissionStatus.Missing;

    //The selected card will be dark with white text meanwhile the other ones stay white
    private string CardStyle(string? status) =>
        selectedStatus == status
            ? "background: var(--lms-nav-bg); color: #fff; padding: 1rem;"
            : "padding: 1rem;";

    //Colour of the number on a card
    private static string CountColour(string status) => status switch
    {
        SubmissionStatus.Late => "text-danger",
        SubmissionStatus.AwaitingFeedback => "text-warning-emphasis",
        SubmissionStatus.Missing => string.Empty,
        SubmissionStatus.FeedbackGiven => "text-info-emphasis",
        _ => string.Empty
    };

    //The deadline will be stored as swedish time and shown as it is
    private static string FormatDateTime(DateTime value) =>
        value.ToString("ddd d MMM yyyy, HH:mm", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}