@page "/my-assignments"

@using System.Globalization
@using System.Linq
@using System.Net
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.AssignmentDtos
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = UserRoles.Student)]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient;
@inject NavigationManager NavigationManager


<h3>My assignments</h3>
<span class="lms-cell-sub">@AssignmentInfo()</span>

@if (isLoading)
{
    @* Loading skeleton while the course is fetched *@
    <div class="lms-card">
        <div class="d-flex flex-column gap-3">
            <div class="lms-skeleton" style="width: 40%; height: 16px;"></div>
            <div class="lms-skeleton" style="width: 70%; height: 16px;"></div>
            <div class="lms-skeleton" style="width: 55%; height: 16px;"></div>
        </div>
        <span class="visually-hidden">Loading your assignments...</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else
{
    <div class="lms-card lms-card-table">
        <div class="table-responsive">
            <table class="table lms-table align-middle">
                <thead>
                    <tr>
                        <th>Assignment</th>
                        <th>Deadline</th>
                        <th>Feedback</th>
                        <th>Status</th>
                        <th>-</th>
                    </tr>
                </thead>
                <tbody>
                    @if (assignments?.Any() ?? false)
                    {
                        @foreach (var item in assignments ?? Enumerable.Empty<StudentAssignmentDto>())
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div>
                                            @* <div class="lms-cell-title">@(string.IsNullOrWhiteSpace(user.Name) ? "—" : user.Name)</div> *@
                                            <div class="lms-cell-title">@item.ActivityName: @item.ActivityDescription)</div>
                                            <div class="lms-cell-sub">@item.CourseName - @item.ModuleName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="lms-cell-title @LateDateClass(item.EndTime)">@FormatDateTime(item.EndTime)</span>
                                </td>
                                <td>
                                    <span class="lms-badge  ">Feedback</span>
                                </td>
                                <td class="text-end">
                                    <span class="lms-badge  ">Status</span>
                                </td>
                                <td>  
                                    <button type="button" class="btn btn-link btn-sm text-decoration-none">Submit</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="d-flex align-items-center gap-2">
                                    You have no assignments
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private IEnumerable<StudentAssignmentDto>? assignments;
    private readonly CancellationTokenSource componentCancellation = new();

    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiProxyClient.GetAsync<IEnumerable<StudentAssignmentDto>>(
                "student/assignments", componentCancellation.Token);

            // The server-side prerender service deliberately returns null. Keep
            // showing the loading state until WebAssembly runs this method again.
            if (result is null)
                return;

            assignments = result;
        }
        catch (OperationCanceledException) when (componentCancellation.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels its request.
            return;
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
                forceLoad: true);
            return;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            errorMessage = "You are not allowed to view this data";
        }
        catch (HttpRequestException)
        {
            errorMessage = "The assignments could not be loaded. Please try again later.";
        }

        isLoading = false;
        StateHasChanged();  // Update GUI
    }

    private string AssignmentInfo()
    {
        var now = DateTime.Now;
        string info = "";

        string courseName = "";
        int countNot = 0;
        int countLat = 0;

        if (assignments is null || !assignments.Any())
            return info;

        foreach(var item in assignments)
        {
            if (string.IsNullOrEmpty(courseName))
                courseName = item.CourseName;

            if (item.Submitted != true)
            {
                countNot++;
            }
            else
            {
                if (item.EndTime < now)
                    countLat++;
            }
        }
        info = courseName + " | " + countNot.ToString() + " | not submitted" + countLat.ToString() + " late";
        
        return info;
    }

// Get colors for Badges - TODO

// Badge colour per activity type (falls back to muted for unknown types)
private static string TextColorClass(string typeName) => typeName switch
{
    "Lecture" => "lms-tone-primary",
    "E-Learning" => "lms-tone-info",
    "Exercise" => "lms-tone-success",
    "Assignment" => "lms-tone-warning",
    _ => "lms-tone-muted"
};

    private static string LateDateClass(DateTime endTime)
    {
        var now = DateTime.Now;
        return endTime < now ? "text-danger" : "";
    }

    // "Mon 12 Oct"
    private static string FormatDateTime(DateTime time) =>
        time.ToString("ddd d MMM, HH:MM", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        componentCancellation.Cancel();
        componentCancellation.Dispose();
    }
}
