@page "/my-assignments"

@using System.Linq
@using System.Net
@using LMS.Blazor.Client.Components.Assignments
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.AssignmentDtos
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = UserRoles.Student)]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient;
@inject NavigationManager NavigationManager


<div class="lms-page-header">
    <div>
        <div class="lms-breadcrumb">
            <!--!--><a href="my-course" b-g4rydwpcux="">My course</a> / Assignments
        </div>
        <h1 class="lms-page-title" tabindex="-1">My Assignments</h1>
        <p class="lms-page-subtitle">@AssignmentInfo()</p>
    </div>
</div>

@if (isLoading)
{
    @* Loading skeleton while the course is fetched *@
    <div class="lms-card">
        <div class="d-flex flex-column gap-3">
            <div class="lms-skeleton" style="width: 40%; height: 16px;"></div>
            <div class="lms-skeleton" style="width: 70%; height: 16px;"></div>
            <div class="lms-skeleton" style="width: 55%; height: 16px;"></div>
        </div>
        <span class="visually-hidden">Loading your assignments...</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else
{
    <div class="lms-card lms-card-table">
        <div class="table-responsive">
            <table class="table lms-table align-middle">
                <thead>
                    <tr>
                        <th>Assignment</th>
                        <th>Deadline</th>
                        <th>Feedback</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (assignments?.Any() ?? false)
                    {
                        @foreach (var item in assignments ?? Enumerable.Empty<StudentAssignmentDto>())
                        {
                            <AssignmentRow Item="@item" />
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="text-center">
                                    You have no assignments
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private IEnumerable<StudentAssignmentDto>? assignments;
    private readonly CancellationTokenSource componentCancellation = new();

    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiProxyClient.GetAsync<IEnumerable<StudentAssignmentDto>>(
                "student/assignments", componentCancellation.Token);

            // The server-side prerender service deliberately returns null. Keep
            // showing the loading state until WebAssembly runs this method again.
            if (result is null)
                return;

            assignments = result;
        }
        catch (OperationCanceledException) when (componentCancellation.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels its request.
            return;
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
                forceLoad: true);
            return;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            errorMessage = "You are not allowed to view this data";
        }
        catch (HttpRequestException)
        {
            errorMessage = "The assignments could not be loaded. Please try again later.";
        }

        isLoading = false;
        StateHasChanged();  // Update GUI
    }

    // Create info under header about status for assignments
    private MarkupString AssignmentInfo()
    {
        if (assignments is null || !assignments.Any())
            return new MarkupString(string.Empty);

        var now = DateTime.Now;
        string courseName = "";
        int countNot = 0;
        int countLate = 0;

        foreach (var item in assignments)
        {
            if (string.IsNullOrEmpty(courseName))
                courseName = item.CourseName;

            if (item.Submitted != true)
                countNot++;
            
            if (item.EndTime < now)
                countLate++;
        }
        
        var info = $"{courseName} &bull; {countNot} not submitted &bull; {countLate} late";
        return new MarkupString(info);
    }

    public void Dispose()
    {
        componentCancellation.Cancel();
        componentCancellation.Dispose();
    }
}
