@page "/users"

@using System.ComponentModel.DataAnnotations
@using System.Net
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.Constants
@using LMS.Shared.DTOs.UserDtos
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@* Teacher page for managing users. Styling comes from wwwroot/css/lms.css. *@
@attribute [Authorize(Roles = UserRoles.Teacher)]
@implements IDisposable

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Users</PageTitle>

<div class="d-flex flex-column gap-4">

    @* ---------- Page header (the title is always "Users") ---------- *@
    <div class="lms-page-header">
        <div>
            <h1 class="lms-page-title">Users</h1>
            <p class="lms-page-subtitle">@UserCountText</p>
        </div>

        @if (!showForm)
        {
            <button type="button" class="btn btn-primary" @onclick="StartCreate">+ New user</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible mb-0" role="status">
            @successMessage
            <button type="button" class="btn-close" aria-label="Close" @onclick="DismissSuccess"></button>
        </div>
    }

    <div class="row g-3">

        @* ---------- User list (left) ---------- *@
        <div class="col-12 @(showForm ? "col-xl-8" : "col-xl-12")">
            @if (isLoading)
            {
                <div class="lms-card">
                    <div class="d-flex flex-column gap-3">
                        <div class="lms-skeleton" style="width: 40%; height: 16px;"></div>
                        <div class="lms-skeleton" style="width: 70%; height: 16px;"></div>
                        <div class="lms-skeleton" style="width: 55%; height: 16px;"></div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="lms-card">
                    <div class="lms-state">
                        <span class="lms-badge lms-tone-danger">!</span>
                        <div class="lms-cell-title">@loadError</div>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ReloadAsync">Try again</button>
                    </div>
                </div>
            }
            else if (users is { Count: 0 })
            {
                <div class="lms-card">
                    <div class="lms-state">
                        <span class="lms-badge lms-tone-primary">+</span>
                        <div class="lms-cell-title">No users yet</div>
                        <div class="lms-cell-sub">Create the first user with the button above.</div>
                    </div>
                </div>
            }
            else if (users is not null)
            {
                <div class="lms-card lms-card-table">
                    <div class="table-responsive">
                        <table class="table lms-table align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Course</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in users)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="lms-avatar @AvatarClass(user.Role)" style="@AvatarStyle(user.Role)">@GetInitials(user)</span>
                                                <div>
                                                    <div class="lms-cell-title">@(string.IsNullOrWhiteSpace(user.Name) ? "—" : user.Name)</div>
                                                    <div class="lms-cell-sub">@user.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="lms-badge @RoleToneClass(user.Role)">@user.Role</span></td>
                                        <td>@CourseText(user)</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-link btn-sm text-decoration-none" @onclick="() => StartEdit(user)">Edit</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        @* ---------- Create / edit form (right) ---------- *@
        @if (showForm)
        {
            <div class="col-12 col-xl-4">
                <div class="lms-card">
                    <h2 class="lms-card-title mb-3">@(editingId is null ? "New user" : "Edit user")</h2>

                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger" role="alert">@formError</div>
                    }

                    <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="user-name">Name *</label>
                                <InputText id="user-name" class="form-control" @bind-Value="form.Name" />
                                <ValidationMessage For="() => form.Name" />
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="user-email">Email *</label>
                                <InputText id="user-email" class="form-control" @bind-Value="form.Email" />
                                <ValidationMessage For="() => form.Email" />
                            </div>

                            @if (editingId is null)
                            {
                                <div class="col-12">
                                    <label class="form-label" for="user-password">Temporary password *</label>
                                    <InputText id="user-password" type="password" class="form-control" autocomplete="new-password" @bind-Value="form.Password" />
                                    @if (!string.IsNullOrWhiteSpace(passwordError))
                                    {
                                        <div class="validation-message">@passwordError</div>
                                    }
                                </div>
                            }

                            @* NEW: when a teacher edits their own account, the role field is hidden
                               by CSS (class "users-role-locked") and a short note is shown instead. *@
                            <div class="col-12 @(editingSelf ? "users-role-locked" : string.Empty)">
                                <label class="form-label" for="user-role">Role *</label>
                                <InputSelect id="user-role" class="form-select" @bind-Value="form.Role">
                                    <option value="">Select role...</option>
                                    @foreach (var role in UserRoles.Assignable)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => form.Role" />
                            </div>

                            @if (editingSelf)
                            {
                                <div class="col-12">
                                    <div class="lms-cell-sub">You cannot change your own role.</div>
                                </div>
                            }

                            @* Only students belong to a course *@
                            @if (form.Role == UserRoles.Student)
                            {
                                <div class="col-12">
                                    <label class="form-label" for="user-course">Course *</label>
                                    <InputSelect id="user-course" class="form-select" @bind-Value="form.CourseId">
                                        <option value="">Select course...</option>
                                        @foreach (var course in courses)
                                        {
                                            <option value="@course.Id">@course.Name</option>
                                        }
                                    </InputSelect>
                                    @if (!string.IsNullOrWhiteSpace(courseFieldError))
                                    {
                                        <div class="validation-message">@courseFieldError</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(courseLoadError))
                                    {
                                        <div class="validation-message">@courseLoadError</div>
                                    }
                                    else
                                    {
                                        <div class="lms-cell-sub mt-1">A student belongs to exactly one course.</div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-secondary" disabled="@isSaving" @onclick="CloseForm">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @(isSaving ? "Saving..." : (editingId is null ? "Create user" : "Save user"))
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // The course list endpoint (teacher only)
    private const string CoursesEndpoint = "courses";

    private readonly CancellationTokenSource cts = new();

    // NEW: the signed-in user, used to detect when a teacher edits their own account
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? currentUserName;
    private bool editingSelf;

    private List<UserDto>? users;
    private List<CourseOption> courses = [];
    private bool isLoading = true;
    private string? loadError;
    private string? courseLoadError;

    private bool showForm;
    private string? editingId;
    private UserFormModel form = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messageStore = default!;
    private bool isSaving;
    private string? formError;
    private string? passwordError;
    private string? courseFieldError;
    private string? successMessage;

    // Subtitle under the title, e.g. "72 students · 4 teachers"
    private string UserCountText
    {
        get
        {
            if (users is null) return string.Empty;

            var students = users.Count(u => u.Role == UserRoles.Student);
            var teachers = users.Count(u => u.Role == UserRoles.Teacher);

            return $"{students} {(students == 1 ? "student" : "students")} · " +
                   $"{teachers} {(teachers == 1 ? "teacher" : "teachers")}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // NEW: remember who is signed in (the identity name is the email address)
        if (AuthState is not null)
        {
            var state = await AuthState;
            currentUserName = state.User.Identity?.Name;
        }

        await LoadUsersAsync();
        await LoadCoursesAsync();
    }

    private async Task ReloadAsync()
    {
        await LoadUsersAsync();
        await LoadCoursesAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var result = await ApiProxyClient.GetAsync<List<UserDto>>("users", cts.Token);

            // The server-side prerender client deliberately returns null. Keep
            // showing the loading state until WebAssembly runs this again.
            if (result is null)
            {
                return;
            }

            users = result;
            isLoading = false;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (HttpRequestException ex)
        {
            loadError = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have access to manage users."
                : "Could not load users. Please try again.";
            isLoading = false;
        }
    }

    private async Task LoadCoursesAsync()
    {
        courseLoadError = null;

        try
        {
            var result = await ApiProxyClient.GetAsync<List<CourseOption>>(CoursesEndpoint, cts.Token);

            if (result is null)
            {
                return;
            }

            courses = result;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (HttpRequestException)
        {
            courseLoadError = "Courses could not be loaded.";
        }
    }

    private void StartCreate()
    {
        editingId = null;
        editingSelf = false;
        form = new UserFormModel();
        CreateEditContext();
        ResetFormErrors();
        successMessage = null;
        showForm = true;
    }

    private void StartEdit(UserDto user)
    {
        editingId = user.Id;

        // NEW: true when the signed-in teacher edits their own account
        editingSelf = !string.IsNullOrWhiteSpace(currentUserName) &&
                      string.Equals(user.Email, currentUserName, StringComparison.OrdinalIgnoreCase);

        // The user DTO only contains course names, so the course is matched by name.
        var courseName = user.CourseNames.FirstOrDefault();
        var courseId = courseName is null
            ? (Guid?)null
            : courses.FirstOrDefault(c => c.Name == courseName)?.Id;

        form = new UserFormModel
        {
            Name = user.Name,
            Email = user.Email,
            Role = UserRoles.Assignable.Contains(user.Role) ? user.Role : string.Empty,
            CourseId = courseId
        };

        CreateEditContext();
        ResetFormErrors();
        successMessage = null;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = null;
        editingSelf = false;
        form = new UserFormModel();
        ResetFormErrors();
    }

    private void CreateEditContext()
    {
        editContext = new EditContext(form);
        messageStore = new ValidationMessageStore(editContext);

        // Clear a field's server error as soon as the user edits that field.
        editContext.OnFieldChanged += (_, e) => messageStore.Clear(e.FieldIdentifier);
    }

    private void ResetFormErrors()
    {
        formError = null;
        passwordError = null;
        courseFieldError = null;
        messageStore?.Clear();
    }

    private void DismissSuccess() => successMessage = null;

    private async Task SaveAsync()
    {
        ResetFormErrors();

        if (editingId is null && form.Password.Length < 3)
        {
            passwordError = "Password must be at least 3 characters.";
        }

        if (form.Role == UserRoles.Student && form.CourseId is null)
        {
            courseFieldError = "Select a course for students.";
        }

        if (passwordError is not null || courseFieldError is not null)
        {
            return;
        }

        isSaving = true;

        try
        {
            var courseId = form.Role == UserRoles.Student ? form.CourseId : null;

            if (editingId is null)
            {
                var dto = new CreateUserDto
                {
                    Name = form.Name.Trim(),
                    Email = form.Email.Trim(),
                    Password = form.Password,
                    Role = form.Role,
                    CourseId = courseId
                };

                await ApiProxyClient.SendAsync<UserDto>(
                    HttpMethod.Post, "users", JsonContent.Create(dto), cts.Token);

                successMessage = $"User '{dto.Name}' was created.";
            }
            else
            {
                var dto = new UpdateUserDto
                {
                    Name = form.Name.Trim(),
                    Email = form.Email.Trim(),
                    Role = form.Role,
                    CourseId = courseId
                };

                await ApiProxyClient.SendAsync<UserDto>(
                    HttpMethod.Put, $"users/{editingId}", JsonContent.Create(dto), cts.Token);

                successMessage = $"User '{dto.Name}' was updated.";
            }

            CloseForm();
            await LoadUsersAsync();
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigating away disposes the component and cancels the request.
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (ApiValidationException ex)
        {
            foreach (var (field, messages) in ex.Errors)
                messageStore.Add(editContext.Field(field), messages);

            if (ex.Errors.Count == 0)
                formError = ex.Message;

            editContext.NotifyValidationStateChanged();
        }
        catch (HttpRequestException ex)
        {
            formError = ex.StatusCode switch
            {
                HttpStatusCode.BadRequest => "The input is invalid. Check the fields and that a student has a course.",
                HttpStatusCode.Conflict => "The email address is already in use.",
                HttpStatusCode.NotFound => "The user no longer exists.",
                HttpStatusCode.Forbidden => "You do not have permission to manage users.",
                _ => "Could not save the user. Please try again."
            };
        }
        finally
        {
            isSaving = false;
        }
    }

    private void RedirectToLogin() =>
        NavigationManager.NavigateTo(
            $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}",
            forceLoad: true);

    private static string CourseText(UserDto user) =>
        user.CourseNames.Count == 0 ? "—" : string.Join(", ", user.CourseNames);

    // Role pill colors: teachers purple, everyone else grey
    private static string RoleToneClass(string role) => role switch
    {
        UserRoles.Teacher => "lms-tone-purple",
        UserRoles.Student => "lms-tone-muted",
        _ => "lms-tone-muted"
    };

    // Teachers get a purple avatar, students the default blue one
    private static string AvatarClass(string role) =>
        role == UserRoles.Teacher ? "is-teacher" : string.Empty;

    // Any other role gets a neutral grey avatar
    private static string AvatarStyle(string role) =>
        role is UserRoles.Teacher or UserRoles.Student ? string.Empty : "background:#6c757d";

    private static string GetInitials(UserDto user)
    {
        var source = string.IsNullOrWhiteSpace(user.Name)
            ? user.Email.Split('@')[0].Replace('.', ' ')
            : user.Name;

        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    // Course shape returned by GET courses (only id and name are needed here)
    public sealed record CourseOption(Guid Id, string Name);

    private sealed class UserFormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [MaxLength(50, ErrorMessage = "Name can be at most 50 characters.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [MaxLength(256, ErrorMessage = "Email can be at most 256 characters.")]
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Select a role.")]
        public string Role { get; set; } = string.Empty;

        public Guid? CourseId { get; set; }
    }
}