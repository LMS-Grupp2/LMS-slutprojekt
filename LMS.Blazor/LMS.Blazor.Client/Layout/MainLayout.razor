@inherits LayoutComponentBase
@using System.Security.Claims
@using LMS.Shared.Constants

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/"><span class="logo">L</span>Lexicon LMS</a>
        <AuthorizeView>
            <Authorized>
                <div class="topbar-right">
                    <span class="avatar">@Initials(context.User.Identity?.Name)</span>
                    <span class="user-text">
                        <span class="user-name">@context.User.Identity?.Name</span>
                        <span class="user-role">@RoleText(context.User)</span>
                    </span>
                    <form action="Account/Logout" method="post" class="m-0">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit" class="logout">Log out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <div class="layout-body">
        <AuthorizeView>
            <Authorized>
                <NavMenu />
            </Authorized>
        </AuthorizeView>
        <main class="main">@Body</main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string RoleText(ClaimsPrincipal user) =>
        user.IsInRole(UserRoles.Teacher) ? "Teacher"
        : user.IsInRole(UserRoles.Student) ? "Student"
        : user.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";

        var cleaned = name.Contains('@') ? name.Split('@')[0].Replace('.', ' ') : name;
        var parts = cleaned.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }
}