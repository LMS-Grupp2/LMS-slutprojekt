@using System.Globalization
@using LMS.Shared.DTOs.AssignmentDtos

<tr class="@RowClass(isLate)">
    <td>
        <div class="d-flex align-items-center gap-2">
            <div>
                <div class="lms-cell-title">@item.ActivityName: @item.ActivityDescription</div>
                <div class="lms-cell-sub">@item.CourseName - @item.ModuleName</div>
            </div>
        </div>
    </td>
    <td>
        <span class="lms-cell-title @(isLate ? "text-danger" : "")">@FormatDateTime(item.EndTime)</span>
    </td>
    <td>
        @if (feedback != "")
        {
            <span class="lms-badge @BadgeClass(feedback)">&#8226; @feedback</span>
        }
    </td>
    <td class="">
        <span class="lms-badge @BadgeClass(status)">@status</span>
    </td>
</tr>

@code {
    [Parameter]
    public StudentAssignmentDto item { get; init; } = null!;

    bool isLate = false;
    string status = "";
    string feedback = "";

    // Runs when data is set
    protected override void OnParametersSet()
    {
        if (item is not null)
        {
            var now = DateTime.Now;
            isLate = (item.EndTime < now) ? true : false;

            // Set status
            // Approved | Needs changes | Submitted | Not submitted or Late
            switch (item.Status)
            {
                case "Approved":
                    status = "Approved";
                    break;
                case "Needs changes":
                    status = "Needs changes";
                    break;
                case "Submitted":
                    status = "Submitted";
                    break;
                default:
                    status = isLate ? "Late" : "Not submitted";
                    break;
            }
            feedback = item.HasFeedback ? "Feedback" : "";
        }
    }

    // Status badge colours
    private static string BadgeClass(string typeName) => typeName switch
    {
        "Late" => "lms-tone-danger",
        "Needs changes" => "lms-tone-danger",
        "Submitted" => "lms-tone-success",
        "Approved" => "lms-tone-success",
        "Feedback" => "lms-tone-primary",
        _ => "lms-tone-muted"
    };

    // Colored background if assignment is late
    private static string RowClass(bool late) =>
        late ? "bg-late" : "";

    // "Mon 12 Oct, 17:00"
    private static string FormatDateTime(DateTime time) =>
    time.ToString("ddd d MMM, HH:MM", CultureInfo.InvariantCulture);
}
