@using System.Globalization
@using LMS.Shared.DTOs.AssignmentDtos
@using LMS.Shared.Constants

<tr class="@RowClass(isLate)">
    <td>
        <div class="d-flex align-items-center gap-2">
            <div>
                @* The assignment name links to the hand-in page (US09), so the student can open and hand in the assignment.
                   If the page gives OnOpen, a click opens the hand-in in a dialog instead (the link still works as a normal link). *@
                <div class="lms-cell-title"><a href="assignments/@item.ActivityId" class="text-decoration-none" @onclick="OpenAsync" @onclick:preventDefault="OnOpen.HasDelegate">@item.ActivityName</a>: <span class="lms-cell-description">@item.ActivityDescription</span></div>
                <div class="lms-cell-sub">@item.CourseName - @item.ModuleName</div>
            </div>
        </div>
    </td>
    <td>
        <span class="lms-cell-title @(isLate ? "text-danger" : "")">@FormatDateTime(item.EndTime)</span>
    </td>
    <td>
        @if (feedback != "")
        {
            <span class="lms-badge @BadgeClass(feedback)">&#8226; @feedback</span>
        }
    </td>
    <td class="">
        <span class="lms-badge lms-tone-@SubmissionStatusStyles.ToneOf(status)">@status</span>
    </td>
</tr>

@code {
    [Parameter]
    public StudentAssignmentDto item { get; init; } = null!;

    // Optional: called with the assignment when the student clicks its name (used to open the hand-in dialog)
    [Parameter]
    public EventCallback<StudentAssignmentDto> OnOpen { get; set; }

    bool isLate = false;
    string status = "";
    string feedback = "";

    // Runs when data is set
    protected override void OnParametersSet()
    {
        if (item is not null)
        {
            status = item.Status ?? string.Empty;
            // Missing submission gets a a highlighted background color
            isLate = (status == SubmissionStatus.Missing) ? true : false;


            feedback = status != SubmissionStatus.FeedbackGiven ? ""
                : item.Approved ? "Approved"
                : item.NeedChanges ? "Needs changes"
                : "Feedback";
        }
    }

    // Tells the page that this assignment was clicked. Without OnOpen the click does nothing here
    // and the link goes to the hand-in page as before.
    private Task OpenAsync() => OnOpen.InvokeAsync(item);

    // Status badge colours
    private static string BadgeClass(string typeName) => typeName switch
    {
        "Needs changes" => "lms-tone-danger",
        "Approved" => "lms-tone-success",
        "Feedback" => "lms-tone-primary",
        _ => "lms-tone-muted"
    };

    // Colored background if assignment is late
    private static string RowClass(bool late) =>
        late ? "bg-late" : "";

    // "Mon 12 Oct, 17:00"
    private static string FormatDateTime(DateTime time) =>
    time.ToString("ddd d MMM, HH:mm", CultureInfo.InvariantCulture);
}